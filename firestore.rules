rules_version = '2';

// Regeln für den Tom-Holland-Duell-Tracker.
// Grundidee: Nur angemeldete Clients (anonyme Firebase-Auth, unsichtbar für den Nutzer)
// dürfen überhaupt lesen/schreiben, und auch dann nur innerhalb von duels/{code}.
// Wer den Code nicht kennt, kann die Workouts nicht finden – der Code ist das Geheimnis.
service cloud.firestore {
  match /databases/{database}/documents {

    // Ein Duell-Dokument hält nur die beiden Anzeigenamen.
    match /duels/{code} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && code.size() >= 4 && code.size() <= 12
                   && request.resource.data.keys().hasOnly(['nameA','nameB','touched'])
                   && (!('nameA' in request.resource.data) || request.resource.data.nameA is string)
                   && (!('nameB' in request.resource.data) || request.resource.data.nameB is string)
                   && (!('nameA' in request.resource.data) || request.resource.data.nameA.size() <= 18)
                   && (!('nameB' in request.resource.data) || request.resource.data.nameB.size() <= 18);

      // Die eigentlichen Workouts.
      match /workouts/{id} {
        allow read: if request.auth != null;

        allow create, update: if request.auth != null
                    && request.resource.data.keys().hasOnly(['slot','date','rounds','notes','ts'])
                    && request.resource.data.slot in ['a','b']
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.rounds is number
                    && request.resource.data.rounds >= 0
                    && request.resource.data.rounds <= 80
                    && request.resource.data.notes is string
                    && request.resource.data.notes.size() <= 300
                    && request.resource.data.ts is number;

        allow delete: if request.auth != null;
      }
    }

    // Alles andere ist dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
