rules_version = '2';

// Regeln für den Duell-Teil des Tom-Holland-Trackers.
//
// Datenmodell: pro Duell gibt es bis zu vier Dokumente – eines je Athlet.
//   duels/{code}/athletes/a  …  duels/{code}/athletes/d
// Darin steht der komplette Workout-Stand dieses Athleten. Alle Geräte
// desselben Athleten schreiben in dasselbe Dokument und führen ihre
// Stände beim Laden zusammen.
//
// Nur angemeldete Clients (anonyme Firebase-Auth, für den Nutzer unsichtbar)
// dürfen lesen und schreiben. Der Challenge-Code ist das Geheimnis: wer ihn
// nicht kennt, findet das Duell nicht.
service cloud.firestore {
  match /databases/{database}/documents {

    // Konto: der komplette Tracker-Zustand einer Person, adressiert über
    // ihren privaten Zugangscode. Der Code ist das Passwort – die Regeln
    // begrenzen nur Form und Grösse der Daten.
    match /athletes/{code} {

      allow read, delete: if request.auth != null
                          && code.size() >= 6 && code.size() <= 16;

      allow create, update: if request.auth != null
                   && code.size() >= 6 && code.size() <= 16
                   && request.resource.data.keys().hasOnly(
                        ['name','updated','workouts','removed','seasons',
                         'currentSeasonId','badges','settings','theme'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 18
                   && request.resource.data.updated is number
                   && request.resource.data.workouts is list
                   && request.resource.data.workouts.size() <= 1000
                   && request.resource.data.removed is list
                   && request.resource.data.removed.size() <= 300
                   && request.resource.data.seasons is list
                   && request.resource.data.seasons.size() <= 100;
    }

    match /duels/{code}/athletes/{slot} {

      allow read: if request.auth != null
                  && code.size() >= 4 && code.size() <= 12;

      // Bewusst getrennt: beim Löschen ist request.resource null, eine
      // gemeinsame write-Regel mit Feldprüfung würde jedes delete abweisen.
      allow delete: if request.auth != null
                    && code.size() >= 4 && code.size() <= 12
                    && slot in ['a', 'b', 'c', 'd'];

      allow create, update: if request.auth != null
                   && code.size() >= 4 && code.size() <= 12
                   && slot in ['a', 'b', 'c', 'd']
                   && request.resource.data.keys().hasOnly(['name','workouts','removed','updated'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() <= 18
                   && request.resource.data.workouts is list
                   && request.resource.data.workouts.size() <= 1000
                   && request.resource.data.removed is list
                   && request.resource.data.removed.size() <= 200
                   && request.resource.data.updated is number;
    }

    // Das Duell-Dokument selbst trägt keine Daten und wird nicht beschrieben.
    // Alles Übrige ist dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
